{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "arm_key_vault_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 24
    },
    "arm_logs_retention_days": {
      "type": "integer",
      "minimum": 30,
      "maximum": 730
    },
    "arm_cluster_name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$",
      "maxLength": 15
    },
    "arm_domain_fqdn": {
      "type": "string"
    },
    "arm_ou_path": {
      "type": "string"
    },
    "arm_naming_prefix": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "maxLength": 8
    },
    "arm_subnet_mask": {
      "type": "string",
      "format": "ipv4"
    },
    "arm_default_gateway": {
      "type": "string",
      "format": "ipv4"
    },
    "arm_starting_ip": {
      "type": "string",
      "format": "ipv4"
    },
    "arm_ending_ip": {
      "type": "string",
      "format": "ipv4"
    },
    "arm_service_principal_app_id": {
      "type": "string",
      "format": "uuid"
    },
    "arm_service_principal_object_id": {
      "type": "string",
      "format": "uuid"
    },
    "arm_service_principal_secret_ref": {
      "type": "string",
      "pattern": "^keyvault://[a-z0-9-]+/.+$"
    },
    "arm_resource_provider_object_id": {
      "type": "string",
      "format": "uuid"
    },
    "arm_mode": {
      "type": "string",
      "enum": [
        "validate_only",
        "deploy"
      ]
    },
    "arm_storage_configuration_mode": {
      "type": "string",
      "enum": [
        "express",
        "advanced"
      ]
    },
    "arc_node_resource_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "format": "azure_resource_id"
      }
    },
    "arm_cluster_telemetry_setting": {
      "type": "string",
      "enum": [
        "full",
        "basic",
        "minimal"
      ]
    },
    "arm_cluster_telemetry_eu_location": {
      "type": "boolean"
    },
    "arm_diagnostics_logs_retention_days": {
      "type": "integer",
      "minimum": 30,
      "maximum": 730
    },
    "arm_security_level": {
      "type": "string",
      "enum": [
        "recommended",
        "customized"
      ]
    },
    "arm_credential_guard_enforced": {
      "type": "boolean"
    },
    "arm_smb_signing_enforced": {
      "type": "boolean"
    },
    "arm_smb_cluster_encryption": {
      "type": "boolean"
    },
    "arm_bitlocker_boot_volume": {
      "type": "boolean"
    },
    "arm_bitlocker_data_volumes": {
      "type": "boolean"
    },
    "arm_wdac_enforced": {
      "type": "boolean"
    },
    "arm_eu_location": {
      "type": "boolean"
    },
    "arm_cluster_pattern": {
      "type": "string",
      "enum": [
        "Standard",
        "RackAware"
      ]
    },
    "arm_local_availability_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "localAvailabilityZoneName": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "arm_dns_servers": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "ipv4"
      }
    },
    "arm_use_dhcp": {
      "type": "boolean"
    },
    "arm_physical_nodes_settings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "ipv4Address": {
            "type": "string",
            "format": "ipv4"
          }
        }
      }
    },
    "arm_networking_type": {
      "type": "string",
      "enum": [
        "switchedMultiServerDeployment",
        "switchlessMultiServerDeployment"
      ]
    },
    "arm_networking_pattern": {
      "type": "string",
      "enum": [
        "hyperConverged",
        "disaggregated"
      ]
    },
    "arm_intent_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "trafficType": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "adapter": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "overrideVirtualSwitchConfiguration": {
            "type": "boolean"
          },
          "virtualSwitchConfigurationOverrides": {
            "type": "object"
          }
        }
      }
    },
    "arm_storage_network_list": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "networkAdapterName": {
            "type": "string"
          },
          "vlanId": {
            "type": "integer"
          }
        }
      }
    },
    "arm_storage_connectivity_switchless": {
      "type": "boolean"
    },
    "arm_enable_storage_auto_ip": {
      "type": "boolean"
    },
    "arm_local_admin_password": {
      "type": "string",
      "pattern": "^keyvault://[a-z0-9-]+/.+$"
    },
    "arm_lcm_admin_username": {
      "type": "string"
    },
    "arm_lcm_admin_password": {
      "type": "string",
      "pattern": "^keyvault://[a-z0-9-]+/.+$"
    },
    "arm_episodic_data_upload": {
      "type": "boolean"
    },
    "arm_streaming_data_client": {
      "type": "boolean"
    },
    "arm_drift_control_enforced": {
      "type": "boolean"
    },
    "arm_sbe_version": {
      "type": "string"
    },
    "arm_sbe_family": {
      "type": "string"
    },
    "arm_sbe_publisher": {
      "type": "string"
    },
    "arm_sbe_manifest_source": {
      "type": "string",
      "format": "url"
    },
    "arm_sbe_manifest_creation_date": {
      "type": "string",
      "format": "date"
    },
    "arm_partner_properties": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "arm_partner_credential_list": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "arm_custom_location": {
      "type": "string",
      "format": "azure_resource_id"
    },
    "arm_storage_account_type": {
      "type": "string",
      "enum": [
        "Standard_LRS",
        "Standard_GRS",
        "Standard_RAGRS"
      ]
    },
    "arm_diagnostic_storage_account_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+$",
      "minLength": 3,
      "maxLength": 24
    },
    "arm_soft_delete_retention_days": {
      "type": "integer",
      "minimum": 7,
      "maximum": 90
    }
  }
}
