arent="1"><mxGeometry x="830" y="60" width="310" height="100" as="geometry"/></mxCell><mxCell id="deps" value="Prerequisite graph&#xa;Hosting, HA, owners, access and evidence&#xa;Reject target-cluster bootstrap cycles" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#172554;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="230" width="310" height="100" as="geometry"/></mxCell><mxCell id="ready" value="Azure foundation + identity + node readiness&#xa;Deploy selected cluster route; verify healthy" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#172554;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="410" width="310" height="100" as="geometry"/></mxCell><mxCell id="choice" value="Enable Azure Local SDN?&#xa;Yes by default for a new design" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#172554;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="450" y="570" width="310" height="100" as="geometry"/></mxCell><mxCell id="no" value="No&#xa;Omit NC / NSG enablement stages&#xa;Existing enabled SDN cannot be removed here" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#172554;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="70" y="730" width="310" height="100" as="geometry"/></mxCell><mxCell id="gate" value="Yes: qualify release, storage and intents&#xa;Check existing NC owner, DNS and access" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#2563eb;fontColor=#172554;fontSize=16;spacing=10;" vertex="1" parent="1"><mxGeometry x="830" y="730" width="310" height="100" as="geometry"/></mxCell><mxCell id="blocked" value="Unknown / incompatible&#xa;Retain intent; show blocker&#xa;Resolve architecture or opt out" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff1f2;strokeColor=#be123c;fontColor=#172554;fontSize=16;spacing=10;" vertex="